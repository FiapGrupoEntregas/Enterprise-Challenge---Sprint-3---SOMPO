# AgroSafe Predictor - Sprint 3
# Copie este arquivo para ".env" e ajuste os valores antes de subir em produção.
# Nunca versionar o arquivo ".env" real (já incluído no .gitignore).

# Chave usada para autenticar requisições no backend (header X-API-Key)
AGROSAFE_API_KEY=agrosafe-dev-key-2025

# Limite de requisições por cliente, por minuto
AGROSAFE_RATE_LIMIT=120
